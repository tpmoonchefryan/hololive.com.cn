[Unit]
Description=Microsoft OAuth client secret health check
After=network-online.target pocketbase.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/hololive.com.cn/backend/scripts
ExecStart=/usr/bin/python3 check_ms_oauth_secret.py
Environment=PB_DATA_DB=/var/www/hololive.com.cn/backend/pb_data/data.db
# 密钥有效期 24 个月，2026-08-13 轮换。换密钥时记得同步改这里。
Environment=MS_OAUTH_SECRET_EXPIRES_ON=2028-08-13
Environment=MS_OAUTH_WARN_DAYS=30
# 退出码 0=正常、3=网络原因未完成检查，都不算失败；
# 1（临期预警）和 2（已失效）会让单元进入 failed，可用 systemctl --failed 看到。
SuccessExitStatus=0 3

[Install]
WantedBy=multi-user.target
